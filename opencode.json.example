{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "n8n-mcp": {
        "type": "local",
        "command": ["npx", "-y", "n8n-mcp"],
        "environment": {
          "MCP_MODE": "stdio",
          "LOG_LEVEL": "error",
          "DISABLE_CONSOLE_OUTPUT": "true",
          "N8N_API_URL": "{env:N8N_API_URL}",
          "N8N_API_KEY": "{env:N8N_API_KEY}"
        },
        "timeout": {"startup": 30000, "catalog": 30000}
      }
    }
  }
}
